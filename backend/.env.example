NODE_ENV=development
PORT=5000

MONGODB_URI=mongodb://127.0.0.1:27017/hack-with-vizag
MONGODB_SERVER_SELECTION_TIMEOUT_MS=10000

JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d
JWT_COOKIE_EXPIRES_IN_DAYS=7
CLIENT_URL=http://localhost:5173

MAX_PPT_UPLOAD_BYTES=20971520
MAX_DOC_UPLOAD_BYTES=20971520
MAX_PROFILE_UPLOAD_BYTES=5242880
MAX_PAYMENT_PROOF_UPLOAD_BYTES=5242880

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-backend-only-secret-key
# SUPABASE_SECRET_KEY may be used instead of SUPABASE_SERVICE_ROLE_KEY.
SUPABASE_STORAGE_BUCKET=hackwithvizag-uploads

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
INQUIRY_RECIPIENT_EMAIL=
